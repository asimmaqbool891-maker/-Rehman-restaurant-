<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rehman Restaurant | Menu</title>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root { --gold: #D4A574; --dark: #0F0F0F; --charcoal: #1A1A1A; --cream: #F5E9D9; }
        body { background: var(--dark); color: var(--cream); font-family: 'Poppins', sans-serif; margin: 0; padding: 15px; }
        
        /* Header & Info Section */
        header { text-align: center; padding: 30px 10px; border-bottom: 2px solid var(--gold); background: linear-gradient(to bottom, #1a1a1a, #0f0f0f); border-radius: 0 0 30px 30px; }
        .logo { font-family: 'Cinzel Decorative', serif; font-size: 2rem; color: var(--gold); margin: 0; }
        .info-bar { font-size: 0.85rem; margin-top: 15px; line-height: 1.6; opacity: 0.9; }
        .btn-call { display: inline-block; margin-top: 15px; padding: 10px 20px; background: var(--gold); color: var(--dark); text-decoration: none; border-radius: 50px; font-weight: 600; font-size: 0.9rem; }

        /* Menu Sections */
        .section-header { color: var(--gold); font-family: 'Cinzel Decorative'; font-size: 1.3rem; margin: 30px 0 15px; display: flex; align-items: center; gap: 10px; }
        .section-header::after { content: ""; flex: 1; height: 1px; background: rgba(212,165,116,0.3); }
        
        .item { display: flex; justify-content: space-between; background: var(--charcoal); padding: 15px; border-radius: 12px; margin-bottom: 12px; border: 1px solid rgba(212,165,116,0.1); box-shadow: 0 4px 15px rgba(0,0,0,0.3); }
        .item-info h4 { margin: 0; font-size: 1rem; color: #fff; }
        .item-info p { margin: 3px 0 0; font-size: 0.75rem; opacity: 0.6; font-style: italic; }
        .price { color: var(--gold); font-weight: 600; font-size: 1rem; align-self: center; }

        footer { text-align: center; padding: 40px 20px; font-size: 0.8rem; opacity: 0.5; }
        .web-link { color: var(--gold); text-decoration: none; font-weight: 600; }
    </style>
</head>
<body>

<header>
    <div class="logo">REHMAN RESTAURANT</div>
    <div class="info-bar">
        📍 Waqar Petrol Pump, Near Khuharo Stop<br>
        📞 0303-3754370<br>
        <a href="tel:03033754370" class="btn-call">📞 Call Now for Delivery</a>
    </div>
</header>

<div class="container">
    <div class="section-header">Traditional Desi 🥘</div>
    <div class="item"><div class="item-info"><h4>Mutton Karahi (Full)</h4><p>Namak Mandi Style Authentic Taste</p></div><div class="price">Rs. 2,800</div></div>
    <div class="item"><div class="item-info"><h4>Chicken White Handi</h4><p>Creamy, Mild & Rich Texture</p></div><div class="price">Rs. 1,650</div></div>
    <div class="item"><div class="item-info"><h4>Special Mutton Pulao</h4><p>Served with Shami Kabab & Raita</p></div><div class="price">Rs. 1,100</div></div>
    <div class="item"><div class="item-info"><h4>Beef Haleem Royal</h4><p>Slow cooked overnight</p></div><div class="price">Rs. 850</div></div>
    <div class="item"><div class="item-info"><h4>Mixed Tandoori Platter</h4><p>BBQ Feast for 2 persons</p></div><div class="price">Rs. 2,200</div></div>

    <div class="section-header">Gourmet Fast Food 🍔</div>
    <div class="item"><div class="item-info"><h4>Monster Beef Burger</h4><p>Double Patty with Signature Sauce</p></div><div class="price">Rs. 1,150</div></div>
    <div class="item"><div class="item-info"><h4>Crunchy Zinger Supreme</h4><p>Extra Crispy with Jalapenos</p></div><div class="price">Rs. 780</div></div>
    <div class="item"><div class="item-info"><h4>Fajita Premium Pizza</h4><p>Fresh Dough & Stuffed Crust</p></div><div class="price">Rs. 1,450</div></div>
    <div class="item"><div class="item-info"><h4>Loaded Cheese Fries</h4><p>Topped with Chicken & Olives</p></div><div class="price">Rs. 550</div></div>

    <div class="section-header">Fresh Juices & Lassi 🥤</div>
    <div class="item"><div class="item-info"><h4>Mint Margarita</h4><p>Classic Refreshing Lime & Mint</p></div><div class="price">Rs. 380</div></div>
    <div class="item"><div class="item-info"><h4>Kulfa Lassi Special</h4><p>Traditional Thick Sweet Lassi</p></div><div class="price">Rs. 350</div></div>
    <div class="item"><div class="item-info"><h4>Fresh Seasonal Juice</h4><p>100% Pure & Healthy</p></div><div class="price">Rs. 450</div></div>
</div>

<footer>
    Visit us online: <br>
    <a href="https://www.rehmanrestaurant.com" class="web-link">www.rehmanrestaurant.com</a><br><br>
    © 2026 Rehman Restaurant - All Rights Reserved
</footer>

</body>
</html>
